{
    "openapi": "3.1.0",
    "info": {
        "title": "ConectaCC",
        "version": "1.0.0",
        "description": "API do ConectaCC"
    },
    "servers": [
        {
            "url": "http://localhost/api/v1"
        }
    ],
    "paths": {
        "/terms/current": {
            "get": {
                "operationId": "v1.currentTerms",
                "tags": [
                    "CurrentTerms"
                ],
                "responses": {
                    "200": {
                        "description": "",
                        "content": {
                            "application/json": {
                                "schema": {}
                            }
                        }
                    }
                }
            }
        },
        "/disciplines": {
            "get": {
                "operationId": "v1.listDisciplines",
                "tags": [
                    "ListDisciplines"
                ],
                "responses": {
                    "200": {
                        "description": "Array of `DisciplineResource`",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "type": "array",
                                    "items": {
                                        "$ref": "#/components/schemas/DisciplineResource"
                                    }
                                }
                            }
                        }
                    },
                    "401": {
                        "$ref": "#/components/responses/AuthenticationException"
                    }
                }
            }
        },
        "/login": {
            "post": {
                "operationId": "v1.login",
                "tags": [
                    "Login"
                ],
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "$ref": "#/components/schemas/LoginRequest"
                            }
                        }
                    }
                },
                "responses": {
                    "200": {
                        "description": "`UserResource`",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/UserResource"
                                }
                            }
                        }
                    },
                    "422": {
                        "$ref": "#/components/responses/ValidationException"
                    }
                }
            }
        },
        "/logout": {
            "post": {
                "operationId": "v1.logout",
                "tags": [
                    "Logout"
                ],
                "responses": {
                    "204": {
                        "description": "No content"
                    },
                    "401": {
                        "$ref": "#/components/responses/AuthenticationException"
                    }
                }
            }
        },
        "/me": {
            "get": {
                "operationId": "v1.me",
                "tags": [
                    "Me"
                ],
                "responses": {
                    "200": {
                        "description": "`UserResource`",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/UserResource"
                                }
                            }
                        }
                    },
                    "401": {
                        "$ref": "#/components/responses/AuthenticationException"
                    }
                }
            }
        },
        "/register": {
            "post": {
                "operationId": "v1.register",
                "tags": [
                    "Register"
                ],
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "$ref": "#/components/schemas/RegisterRequest"
                            }
                        }
                    }
                },
                "responses": {
                    "201": {
                        "description": "",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "type": "object",
                                    "properties": {
                                        "message": {
                                            "type": "string",
                                            "const": "Conta criada."
                                        }
                                    },
                                    "required": [
                                        "message"
                                    ]
                                }
                            }
                        }
                    },
                    "422": {
                        "$ref": "#/components/responses/ValidationException"
                    }
                }
            }
        },
        "/profile": {
            "get": {
                "operationId": "v1.showProfile",
                "tags": [
                    "ShowProfile"
                ],
                "responses": {
                    "200": {
                        "description": "`ProfileResource`",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/ProfileResource"
                                }
                            }
                        }
                    },
                    "401": {
                        "$ref": "#/components/responses/AuthenticationException"
                    }
                }
            },
            "put": {
                "operationId": "v1.updateProfile",
                "tags": [
                    "UpdateProfile"
                ],
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "$ref": "#/components/schemas/UpdateProfileRequest"
                            }
                        }
                    }
                },
                "responses": {
                    "200": {
                        "description": "`ProfileResource`",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/ProfileResource"
                                }
                            }
                        }
                    },
                    "401": {
                        "$ref": "#/components/responses/AuthenticationException"
                    },
                    "422": {
                        "$ref": "#/components/responses/ValidationException"
                    }
                }
            }
        }
    },
    "components": {
        "schemas": {
            "DisciplineResource": {
                "type": "object",
                "properties": {
                    "id": {
                        "type": "integer"
                    },
                    "name": {
                        "type": "string"
                    },
                    "slug": {
                        "type": "string"
                    },
                    "semester": {
                        "type": "integer"
                    },
                    "workload_hours": {
                        "type": "integer"
                    },
                    "syllabus_url": {
                        "type": [
                            "string",
                            "null"
                        ]
                    }
                },
                "required": [
                    "id",
                    "name",
                    "slug",
                    "semester",
                    "workload_hours",
                    "syllabus_url"
                ],
                "title": "DisciplineResource"
            },
            "LoginRequest": {
                "type": "object",
                "properties": {
                    "email": {
                        "type": "string",
                        "format": "email"
                    },
                    "password": {
                        "type": "string"
                    }
                },
                "required": [
                    "email",
                    "password"
                ],
                "title": "LoginRequest"
            },
            "ProfileResource": {
                "type": "object",
                "properties": {
                    "display_name": {
                        "type": "string"
                    },
                    "initials": {
                        "type": "string"
                    },
                    "about": {
                        "type": [
                            "string",
                            "null"
                        ]
                    },
                    "interests": {
                        "type": "array",
                        "items": {
                            "type": "string"
                        }
                    },
                    "can_help_with": {
                        "type": "array",
                        "items": {
                            "type": "string"
                        }
                    },
                    "needs_help_with": {
                        "type": "array",
                        "items": {
                            "type": "string"
                        }
                    },
                    "github_url": {
                        "type": [
                            "string",
                            "null"
                        ]
                    },
                    "linkedin_url": {
                        "type": [
                            "string",
                            "null"
                        ]
                    },
                    "disciplines": {
                        "type": "array",
                        "items": {
                            "$ref": "#/components/schemas/DisciplineResource"
                        }
                    },
                    "complete": {
                        "type": "boolean"
                    }
                },
                "required": [
                    "display_name",
                    "initials",
                    "about",
                    "interests",
                    "can_help_with",
                    "needs_help_with",
                    "github_url",
                    "linkedin_url",
                    "disciplines",
                    "complete"
                ],
                "title": "ProfileResource"
            },
            "RegisterRequest": {
                "type": "object",
                "properties": {
                    "name": {
                        "type": "string",
                        "maxLength": 120
                    },
                    "email": {
                        "type": "string",
                        "format": "email"
                    },
                    "password": {
                        "type": "string",
                        "minLength": 8
                    },
                    "password_confirmation": {
                        "type": "string"
                    },
                    "terms_version": {
                        "type": "string",
                        "description": "closure em vez de Rule::in: a vers\u00e3o vigente \u00e9 configura\u00e7\u00e3o e n\u00e3o deve virar enum no OpenAPI"
                    }
                },
                "required": [
                    "name",
                    "email",
                    "password",
                    "password_confirmation",
                    "terms_version"
                ],
                "title": "RegisterRequest"
            },
            "Role": {
                "type": "string",
                "enum": [
                    "ALUNO",
                    "MODERADOR",
                    "ADMINISTRADOR"
                ],
                "title": "Role"
            },
            "UpdateProfileRequest": {
                "type": "object",
                "properties": {
                    "display_name": {
                        "type": "string",
                        "maxLength": 120
                    },
                    "discipline_ids": {
                        "type": "array",
                        "items": {
                            "type": "integer"
                        },
                        "minItems": 1
                    },
                    "about": {
                        "type": [
                            "string",
                            "null"
                        ],
                        "maxLength": 5000
                    },
                    "github_url": {
                        "type": [
                            "string",
                            "null"
                        ]
                    },
                    "linkedin_url": {
                        "type": [
                            "string",
                            "null"
                        ]
                    },
                    "interests": {
                        "type": "array",
                        "items": {
                            "type": "string",
                            "maxLength": 255
                        },
                        "maxItems": 50
                    },
                    "can_help_with": {
                        "type": "array",
                        "items": {
                            "type": "string",
                            "maxLength": 255
                        },
                        "maxItems": 50
                    },
                    "needs_help_with": {
                        "type": "array",
                        "items": {
                            "type": "string",
                            "maxLength": 255
                        },
                        "maxItems": 50
                    }
                },
                "required": [
                    "display_name",
                    "discipline_ids",
                    "interests",
                    "can_help_with",
                    "needs_help_with"
                ],
                "title": "UpdateProfileRequest"
            },
            "UserResource": {
                "type": "object",
                "properties": {
                    "id": {
                        "type": "integer"
                    },
                    "name": {
                        "type": "string"
                    },
                    "display_name": {
                        "type": "string"
                    },
                    "initials": {
                        "type": "string"
                    },
                    "role": {
                        "$ref": "#/components/schemas/Role"
                    },
                    "profile_complete": {
                        "type": "boolean"
                    }
                },
                "required": [
                    "id",
                    "name",
                    "display_name",
                    "initials",
                    "role",
                    "profile_complete"
                ],
                "title": "UserResource"
            }
        },
        "responses": {
            "ValidationException": {
                "description": "Validation error",
                "content": {
                    "application/json": {
                        "schema": {
                            "type": "object",
                            "properties": {
                                "message": {
                                    "type": "string",
                                    "description": "Errors overview."
                                },
                                "errors": {
                                    "type": "object",
                                    "description": "A detailed description of each field that failed validation.",
                                    "additionalProperties": {
                                        "type": "array",
                                        "items": {
                                            "type": "string"
                                        }
                                    }
                                }
                            },
                            "required": [
                                "message",
                                "errors"
                            ]
                        }
                    }
                }
            },
            "AuthenticationException": {
                "description": "Unauthenticated",
                "content": {
                    "application/json": {
                        "schema": {
                            "type": "object",
                            "properties": {
                                "message": {
                                    "type": "string",
                                    "description": "Error overview."
                                }
                            },
                            "required": [
                                "message"
                            ]
                        }
                    }
                }
            }
        }
    }
}